<Window x:Class="CPanCleaner.Gui.HighRiskConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="高风险操作确认" Width="520" Height="350" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F9FAFB" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="此操作可能造成不可恢复的数据或系统状态变化" FontSize="18" FontWeight="SemiBold" Foreground="#B42318" TextWrapping="Wrap" />
            <TextBlock x:Name="FeatureTitleText" Margin="0,10,0,0" FontWeight="SemiBold" Foreground="#101828" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,16,0,16" Background="#FFF4ED" BorderBrush="#FDB022" BorderThickness="1" CornerRadius="8" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" LineHeight="20" Foreground="#7A2E0E" />
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="确认已查看预览结果后，在下方输入“执行”" Foreground="#475467" />
            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="取消" Width="76" Padding="8,6" Margin="0,0,8,0" Click="Cancel_OnClick" />
                    <Button x:Name="ConfirmButton" Content="确认执行" Width="90" Padding="8,6" IsEnabled="False" Background="#B42318" Foreground="White" BorderThickness="0" Click="Confirm_OnClick" />
                </StackPanel>
                <TextBox x:Name="ConfirmationText" VerticalContentAlignment="Center" Padding="8,5" TextChanged="ConfirmationText_OnTextChanged" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
