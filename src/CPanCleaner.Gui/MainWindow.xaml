<Window x:Class="CPanCleaner.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPanCleaner · Windows 空间与性能维护"
        Width="1280" Height="820" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#E4E7EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Margin" Value="0,13,0,5" />
        </Style>
        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#475467" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#175CD3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="MaxWidth" Value="720" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="680" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultCellTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
        </Style>
        <DataTemplate x:Key="FeatureItemTemplate">
            <Border Padding="11" Margin="2,2,2,4" CornerRadius="8" BorderBrush="#EAECF0" BorderThickness="1" Background="#FCFCFD">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding AccentBrush}" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#101828" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}" Margin="0,4,0,0" Foreground="#667085" FontSize="11" TextWrapping="Wrap" MaxHeight="34" />
                        <TextBlock Text="{Binding AdministratorText}" Margin="0,5,0,0" Foreground="{Binding AccentBrush}" FontSize="10" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="GroupedFeatureListStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemTemplate" Value="{StaticResource FeatureItemTemplate}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <GroupStyle x:Key="FeatureGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" Margin="8,14,6,6" FontWeight="SemiBold" FontSize="12" Foreground="#475467" />
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20,15" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CPanCleaner" FontSize="24" FontWeight="SemiBold" Foreground="#101828" />
                    <TextBlock Text="先预览、再确认、最后执行；功能按实际影响分层。" Margin="0,4,0,0" Foreground="#667085" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF8FF" CornerRadius="8" Padding="13,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="C 盘状态" FontSize="10" Foreground="#175CD3" />
                            <TextBlock Text="{Binding DriveText}" FontWeight="SemiBold" Foreground="#1849A9" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F2F4F7" CornerRadius="8" Padding="13,8">
                        <StackPanel>
                            <TextBlock Text="当前权限" FontSize="10" Foreground="#667085" />
                            <TextBlock Text="{Binding AdministratorText}" FontWeight="SemiBold" Foreground="#344054" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                <TabControl x:Name="RiskTabs" BorderThickness="0" Background="Transparent" SelectionChanged="RiskTabs_OnSelectionChanged">
                    <TabItem Header="安全">
                        <ListBox x:Name="LowRiskList" Style="{StaticResource GroupedFeatureListStyle}" SelectionChanged="FeatureList_OnSelectionChanged">
                            <ListBox.GroupStyle><StaticResource ResourceKey="FeatureGroupStyle" /></ListBox.GroupStyle>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="中等风险">
                        <ListBox x:Name="MediumRiskList" Style="{StaticResource GroupedFeatureListStyle}" SelectionChanged="FeatureList_OnSelectionChanged">
                            <ListBox.GroupStyle><StaticResource ResourceKey="FeatureGroupStyle" /></ListBox.GroupStyle>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="高风险">
                        <ListBox x:Name="HighRiskList" Style="{StaticResource GroupedFeatureListStyle}" SelectionChanged="FeatureList_OnSelectionChanged">
                            <ListBox.GroupStyle><StaticResource ResourceKey="FeatureGroupStyle" /></ListBox.GroupStyle>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="250" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedFeature}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="{Binding AccentBrush}" CornerRadius="10" Padding="11,5" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding RiskText}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Group}" Foreground="#667085" FontSize="11" />
                                        <TextBlock Text="{Binding Title}" Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" Foreground="#101828" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyTextStyle}" FontSize="14" Margin="0,10,0,4" />

                                <TextBlock Text="实现原理" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding Principle}" Style="{StaticResource BodyTextStyle}" />

                                <TextBlock Text="可能影响" Style="{StaticResource SectionTitleStyle}" />
                                <Border Background="#FFF8F6" BorderBrush="#FECDCA" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <TextBlock Text="{Binding Impact}" Style="{StaticResource BodyTextStyle}" Foreground="#912018" />
                                </Border>

                                <TextBlock Text="安全护栏" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding Safeguards}" Style="{StaticResource BodyTextStyle}" />

                                <TextBlock Text="涉及位置 / 组件" Style="{StaticResource SectionTitleStyle}" />
                                <ItemsControl ItemsSource="{Binding AffectedPaths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9FAFB" CornerRadius="5" Padding="9,5" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Foreground="#344054" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="历史来源" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding History}" Style="{StaticResource BodyTextStyle}" Foreground="#175CD3" />
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1" BorderBrush="#EAECF0" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="MinimumAgePanel" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="临时文件最小保留" VerticalAlignment="Center" Foreground="#475467" />
                                    <TextBox x:Name="MinimumAgeDaysBox" Text="1" Width="38" Margin="8,0,5,0" HorizontalContentAlignment="Center" />
                                    <TextBlock Text="天" VerticalAlignment="Center" Foreground="#475467" />
                                </StackPanel>
                                <StackPanel x:Name="GuardSchedulePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="执行周期" VerticalAlignment="Center" Foreground="#475467" />
                                    <TextBox x:Name="GuardIntervalMinutesBox" Text="15" Width="58" Margin="8,0,5,0" HorizontalContentAlignment="Center" />
                                    <TextBlock Text="分钟（5–1440）" VerticalAlignment="Center" Foreground="#475467" />
                                </StackPanel>
                                <StackPanel x:Name="DestinationPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="{Binding SelectedFeature.DestinationLabel}" VerticalAlignment="Center" Foreground="#475467" />
                                    <TextBox x:Name="DestinationPathBox" Width="270" Margin="8,0,6,0" />
                                    <Button Content="浏览…" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Click="BrowseDestinationButton_OnClick" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="PreviewButton" Content="{Binding SelectedFeature.PreviewLabel}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="PreviewButton_OnClick" />
                                    <Button x:Name="DisableGuardButton" Content="关闭并移除任务" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Visibility="Collapsed" Click="DisableGuardButton_OnClick" />
                                    <Button x:Name="ApplyButton" Content="{Binding SelectedFeature.ApplyLabel}" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyButton_OnClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="2,0,2,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,6,0" IsEnabled="{Binding IsBusy}" Click="CancelButton_OnClick" />
                                <Button Content="打开日志" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Click="OpenLogsButton_OnClick" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="执行结果" FontWeight="SemiBold" Foreground="#101828" />
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#667085" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <DataGrid x:Name="ResultGrid" Grid.Row="1" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="False"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  BorderThickness="0" RowHeaderWidth="0" Background="White"
                                  PreviewMouseRightButtonDown="ResultGrid_OnPreviewMouseRightButtonDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu Opened="ResultContextMenu_OnOpened">
                                    <MenuItem x:Name="OpenResultLocationMenuItem"
                                              Header="打开选中条目所在文件夹"
                                              Click="OpenResultLocationMenuItem_OnClick" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50">
                                    <DataGridCheckBoxColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
                                            <Setter Property="ToolTip" Value="只有带有精确清理白名单或逐文件身份校验的结果才可选择。" />
                                        </Style>
                                    </DataGridCheckBoxColumn.CellStyle>
                                </DataGridCheckBoxColumn>
                                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="85" IsReadOnly="True" ElementStyle="{StaticResource ResultCellTextStyle}" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" IsReadOnly="True" ElementStyle="{StaticResource ResultCellTextStyle}" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="125" IsReadOnly="True" ElementStyle="{StaticResource ResultCellTextStyle}" />
                                <DataGridTextColumn Header="实际占用" Binding="{Binding DisplaySize}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource ResultCellTextStyle}" />
                                <DataGridTextColumn Header="阻塞进程" Binding="{Binding ProcessBlockers}" Width="140" IsReadOnly="True" ElementStyle="{StaticResource ResultCellTextStyle}" />
                                <DataGridTextColumn Header="路径 / 详情" Binding="{Binding Path}" Width="*" MinWidth="220" IsReadOnly="True" ElementStyle="{StaticResource ResultCellTextStyle}" />
                                <DataGridTextColumn Header="建议 / 说明" Binding="{Binding DetailText}" Width="2*" MinWidth="320" IsReadOnly="True" ElementStyle="{StaticResource ResultCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="2,11,2,0">
            <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Window>
